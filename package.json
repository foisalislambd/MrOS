{
  "name": "mros",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@mros/db",
    "db:migrate": "turbo run db:migrate --filter=@mros/db",
    "db:studio": "turbo run db:studio --filter=@mros/db",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
